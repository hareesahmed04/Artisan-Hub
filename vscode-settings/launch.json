{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ArtisanHub",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/ArtisanHub/bin/Debug/net8.0/ArtisanHub.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ArtisanHub",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      }
    }
  ]
}
