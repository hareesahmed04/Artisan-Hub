@model List<SellerProductRowVm>
@{
    ViewData["Title"] = "My products";
    var artist = ViewData["Artist"] as Artist;
}
@section TopActions {
    <a class="btn btn-primary btn-sm" asp-action="CreateProduct"><i class="bi bi-plus-lg me-1"></i> Add product</a>
}

@if (artist != null)
{
    <partial name="_VerifyBanner" model="artist" />
}

<div class="panel-card">
    <div class="card-head">
        <h5>@Fmt.Plural(Model.Count, "product")</h5>
        <span class="small text-muted">Hidden products stay in your list but do not appear in the shop.</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-box-seam"></i>
            <p>You have not listed anything yet.</p>
            <a class="btn btn-primary" asp-action="CreateProduct">Add your first product</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Product</th><th>Category</th><th class="text-end">Price</th><th class="text-center">Stock</th><th class="text-center">Sold</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@p.ImageUrl" alt="" class="mini-thumb" />
                                    <div>
                                        <a class="fw-bold text-reset" asp-action="EditProduct" asp-route-id="@p.ProductID">@p.Title</a>
                                        @if (p.IsCustomizable)
                                        {
                                            <div class="small text-terra"><i class="bi bi-brush me-1"></i>Custom orders</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="small">@p.CategoryName</td>
                            <td class="text-end fw-semibold">@Fmt.Money(p.Price)</td>
                            <td class="text-center"><span class="pill @(p.StockQty == 0 ? "pill-stop" : p.StockQty <= 3 ? "pill-pending" : "pill-done")">@p.StockQty</span></td>
                            <td class="text-center">@p.UnitsSold</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="pill pill-done">Visible</span>
                                }
                                else
                                {
                                    <span class="pill pill-stop">Hidden</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-soft btn-sm" asp-action="EditProduct" asp-route-id="@p.ProductID"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="ToggleProduct" asp-route-id="@p.ProductID" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-link text-muted" type="submit">@(p.IsActive ? "Hide" : "Show")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
