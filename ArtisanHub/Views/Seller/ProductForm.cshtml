@model ProductFormVm
@{
    var isEdit = Model.ProductID.HasValue;
    ViewData["Title"] = isEdit ? "Edit product" : "Add a product";
}
@section TopActions {
    <a class="btn btn-soft btn-sm" asp-action="Products"><i class="bi bi-arrow-left me-1"></i> Back to products</a>
}

<form asp-action="@(isEdit ? "EditProduct" : "CreateProduct")" asp-route-id="@Model.ProductID" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="flash flash-error mb-3"></div>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="panel-card card-pad mb-4">
                <h5 class="mb-3">Product details</h5>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Hand-thrown terracotta vase" />
                    <span asp-validation-for="Title" class="field-validation-error"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryID" class="form-label"></label>
                        <select asp-for="CategoryID" asp-items="Model.Categories" class="form-select">
                            <option value="">Choose category</option>
                        </select>
                        <span asp-validation-for="CategoryID" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" min="1" step="1" />
                        <span asp-validation-for="Price" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="StockQty" class="form-label"></label>
                        <input asp-for="StockQty" class="form-control" type="number" min="0" step="1" />
                        <span asp-validation-for="StockQty" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="6" placeholder="Materials, size, how it is made, care instructions"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>
                <div class="d-flex flex-wrap gap-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsCustomizable" class="form-check-input" role="switch" />
                        <label asp-for="IsCustomizable" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="panel-card card-pad mb-4">
                <h5 class="mb-3">Photos</h5>
                @if (Model.ExistingImages.Count > 0)
                {
                    <div class="row g-2 mb-3">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="col-6">
                                <div class="img-tile">
                                    <img src="@img.ImageUrl" alt="" />
                                    @if (img.IsPrimary)
                                    {
                                        <span class="tag tag-terra primary">Main</span>
                                    }
                                </div>
                                <div class="d-flex gap-1 mt-1">
                                    @if (!img.IsPrimary)
                                    {
                                        <button class="btn btn-soft btn-sm flex-grow-1" type="submit" formaction="@Url.Action("SetPrimaryImage", new { imageId = img.ImageID })" formnovalidate>Make main</button>
                                    }
                                    <button class="btn btn-link btn-sm text-danger" type="submit" formaction="@Url.Action("DeleteImage", new { imageId = img.ImageID })" formnovalidate onclick="return confirm('Remove this photo?')">Remove</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="upload-zone mb-3">
                    <i class="bi bi-cloud-arrow-up fs-2 text-terra"></i>
                    <div class="fw-semibold mb-2">Upload photos</div>
                    <input asp-for="Uploads" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple data-file-list="#fileNames" />
                    <div id="fileNames" class="small text-muted mt-2"></div>
                    <div class="small text-muted mt-1">JPG, PNG, WEBP or GIF, up to 5 MB each.</div>
                </div>
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ImageUrl" class="field-validation-error"></span>
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-check2 me-1"></i> @(isEdit ? "Save changes" : "Add product")</button>
                @if (isEdit)
                {
                    <a class="btn btn-soft" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductID" target="_blank"><i class="bi bi-eye me-1"></i> Preview in shop</a>
                }
            </div>
        </div>
    </div>
</form>
