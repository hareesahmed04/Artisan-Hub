@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdminPanel = controller == "Admin";
    var title = ViewData["Title"] as string ?? (isAdminPanel ? "Admin" : "Seller panel");
    var hasFlash = TempData.Peek("Success") != null || TempData.Peek("Error") != null || TempData.Peek("Info") != null;

    string Active(params string[] actions) => actions.Contains(action) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · ArtisanHub @(isAdminPanel ? "Admin" : "Seller")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@@9..144,500;9..144,600;9..144,700&family=Manrope:wght@@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="panel-body">
    <div class="panel-shell">
        <aside class="panel-side">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-mark.svg" alt="ArtisanHub logo" />
                <span class="brand-name">Artisan<span>Hub</span></span>
            </a>
            <div class="role-tag">@(isAdminPanel ? "Admin panel" : "Seller panel")</div>

            <nav class="nav flex-column">
                @if (isAdminPanel)
                {
                    <a class="nav-link @Active("Index")" asp-controller="Admin" asp-action="Index"><i class="bi bi-grid-1x2"></i>Dashboard</a>
                    <a class="nav-link @Active("Artists")" asp-controller="Admin" asp-action="Artists"><i class="bi bi-patch-check"></i>Artists</a>
                    <a class="nav-link @Active("Categories")" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags"></i>Categories</a>
                    <a class="nav-link @Active("Users")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i>Users</a>
                    <a class="nav-link @Active("Orders")" asp-controller="Admin" asp-action="Orders"><i class="bi bi-receipt"></i>Orders</a>
                    <a class="nav-link @Active("Reports")" asp-controller="Admin" asp-action="Reports"><i class="bi bi-bar-chart-line"></i>Reports</a>
                }
                else
                {
                    <a class="nav-link @Active("Dashboard", "Index")" asp-controller="Seller" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i>Dashboard</a>
                    <a class="nav-link @Active("Products", "CreateProduct", "EditProduct")" asp-controller="Seller" asp-action="Products"><i class="bi bi-box-seam"></i>My products</a>
                    <a class="nav-link @Active("Orders")" asp-controller="Seller" asp-action="Orders"><i class="bi bi-truck"></i>Orders &amp; shipping</a>
                    <a class="nav-link @Active("Requests")" asp-controller="Seller" asp-action="Requests"><i class="bi bi-brush"></i>Custom requests</a>
                    <a class="nav-link @Active("Sales")" asp-controller="Seller" asp-action="Sales"><i class="bi bi-graph-up-arrow"></i>Sales report</a>
                    <a class="nav-link @Active("Store")" asp-controller="Seller" asp-action="Store"><i class="bi bi-shop"></i>Store profile</a>
                }
            </nav>

            <div class="side-foot">
                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i>Visit the shop</a>
                <a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear"></i>Account settings</a>
            </div>
        </aside>

        <div class="panel-main">
            <header class="panel-top">
                <div>
                    <div class="small-caps text-muted">@(isAdminPanel ? "Admin" : "Seller")</div>
                    <h1 class="panel-title">@title</h1>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @await RenderSectionAsync("TopActions", required: false)
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <span class="avatar @(isAdminPanel ? "avatar-olive" : "")">@Fmt.Initials(User.GetDisplayName())</span>
                        <div class="lh-sm">
                            <div class="fw-bold">@User.GetDisplayName()</div>
                            <div class="small text-muted">@(isAdminPanel ? "Administrator" : "Artist")</div>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-soft btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button>
                    </form>
                </div>
            </header>
            <div class="panel-content">
                @if (hasFlash)
                {
                    <partial name="_Flash" />
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
