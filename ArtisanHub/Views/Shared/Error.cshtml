@{
    ViewData["Title"] = "Something went wrong";
}
<section class="container py-5 text-center">
    <div class="py-5">
        <img src="~/images/products/p3.svg" alt="" width="180" class="rounded-4 mb-4" />
        <h1>Something went wrong</h1>
        <p class="text-muted mx-auto" style="max-width:480px">We could not finish that request. Please go back and try again. If it keeps happening, check that SQL Server is running.</p>
        <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</section>
