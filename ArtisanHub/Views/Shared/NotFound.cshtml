@{
    ViewData["Title"] = "Page not found";
}
<section class="container py-5 text-center">
    <div class="py-5">
        <img src="~/images/placeholder.svg" alt="" width="180" class="rounded-4 mb-4" />
        <h1>We couldn't find that page</h1>
        <p class="text-muted mx-auto" style="max-width:460px">The item may have been sold out, hidden by its artist, or the link may be wrong.</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Browse the shop</a>
            <a class="btn btn-soft" asp-controller="Home" asp-action="Index">Home</a>
        </div>
    </div>
</section>
