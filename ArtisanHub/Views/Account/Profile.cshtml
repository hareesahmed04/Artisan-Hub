@model ProfilePageVm
@{
    ViewData["Title"] = "Profile & settings";
    var isCustomer = Model.RoleName == RoleNames.Customer;
}
<div class="container">
    <div class="page-head">
        <div class="d-flex align-items-center gap-3">
            <span class="avatar avatar-lg">@Fmt.Initials(Model.Profile.FullName)</span>
            <div>
                <h1>@Model.Profile.FullName</h1>
                <div class="meta mt-1">
                    <span><i class="bi bi-envelope"></i>@Model.Email</span>
                    <span><i class="bi bi-person-badge"></i>@Model.RoleName account</span>
                    <span><i class="bi bi-calendar3"></i>Member since @Fmt.Date(Model.MemberSince)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card-soft card-pad h-100">
                <h5 class="mb-3">Personal details</h5>
                <form asp-action="UpdateProfile" method="post">
                    <div class="mb-3">
                        <label asp-for="Profile.FullName" class="form-label"></label>
                        <input asp-for="Profile.FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.Phone" class="form-label"></label>
                        <input asp-for="Profile.Phone" class="form-control" placeholder="03xx-xxxxxxx" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    <button class="btn btn-primary" type="submit">Save details</button>
                </form>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card-soft card-pad h-100">
                <h5 class="mb-3">Change password</h5>
                <form asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label asp-for="Password.CurrentPassword" class="form-label"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password.NewPassword" class="form-label"></label>
                            <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password.ConfirmNewPassword" class="form-label"></label>
                            <input asp-for="Password.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        </div>
                    </div>
                    <button class="btn btn-dark" type="submit">Update password</button>
                </form>
            </div>
        </div>

        @if (isCustomer)
        {
            <div class="col-12">
                <div class="card-soft card-pad">
                    <h5 class="mb-3">Delivery addresses</h5>
                    <div class="row g-3 mb-4">
                        @if (Model.Addresses.Count == 0)
                        {
                            <div class="col-12 text-muted">You have not saved an address yet.</div>
                        }
                        @foreach (var a in Model.Addresses)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="choice h-100 flex-column" style="cursor:default">
                                    <div class="d-flex justify-content-between w-100">
                                        <span class="fw-bold"><i class="bi bi-geo-alt text-terra me-1"></i>@a.City.CityName</span>
                                        @if (a.IsDefault)
                                        {
                                            <span class="pill pill-done">Default</span>
                                        }
                                    </div>
                                    <div class="text-muted">@(a.AddressLine + (a.PostalCode != null ? ", " + a.PostalCode : ""))</div>
                                    <div class="d-flex gap-2 mt-auto">
                                        @if (!a.IsDefault)
                                        {
                                            <form asp-action="SetDefaultAddress" asp-route-id="@a.AddressID" method="post">
                                                <button class="btn btn-sm btn-soft" type="submit">Make default</button>
                                            </form>
                                        }
                                        @if (!Model.AddressesInUse.Contains(a.AddressID))
                                        {
                                            <form asp-action="DeleteAddress" asp-route-id="@a.AddressID" method="post" data-confirm="Delete this address?">
                                                <button class="btn btn-sm btn-link text-danger p-1" type="submit">Delete</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <h6 class="mb-3">Add a new address</h6>
                    <form asp-action="AddAddress" method="post">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label asp-for="NewAddress.AddressLine" class="form-label"></label>
                                <input asp-for="NewAddress.AddressLine" class="form-control" placeholder="House, street, area" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="NewAddress.CityID" class="form-label"></label>
                                <select asp-for="NewAddress.CityID" asp-items="Model.Cities" class="form-select">
                                    <option value="">Choose city</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="NewAddress.PostalCode" class="form-label"></label>
                                <input asp-for="NewAddress.PostalCode" class="form-control" />
                            </div>
                            <div class="col-md-2 d-grid">
                                <button class="btn btn-primary" type="submit">Add address</button>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="NewAddress.IsDefault" class="form-check-input" />
                                    <label asp-for="NewAddress.IsDefault" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
