@{
    ViewData["Title"] = "Access denied";
}
<section class="container py-5 text-center">
    <div class="py-5">
        <div class="step-card d-inline-block px-5">
            <div class="icon mx-auto"><i class="bi bi-shield-lock"></i></div>
            <h2>This page isn't for your account</h2>
            <p class="text-muted mx-auto" style="max-width:440px">You are signed in, but this part of ArtisanHub belongs to a different type of account (customer, artist or admin).</p>
            <div class="d-flex gap-2 justify-content-center">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to home</a>
                <form asp-action="Logout" method="post">
                    <button class="btn btn-soft" type="submit">Sign in with another account</button>
                </form>
            </div>
        </div>
    </div>
</section>
